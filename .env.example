# The real, running Vitals web application. The "Open Vitals" buttons point here.
NEXT_PUBLIC_APP_URL=https://vital-app-ivory.vercel.app

# Mobile app store listings.
#
# Leave these EMPTY until the apps are actually published. While empty the store
# buttons render as "Coming soon" and are not links — the section is built so
# that setting these is the only change needed at launch.
NEXT_PUBLIC_APP_STORE_URL=
NEXT_PUBLIC_PLAY_STORE_URL=

# Where the waitlist form posts. No such endpoint exists in the Vitals backend
# yet; point this at whatever collects sign-ups (a form service, or a route added
# later). While empty the form explains that sign-ups are not open rather than
# accepting an address and dropping it.
NEXT_PUBLIC_WAITLIST_ENDPOINT=

# Shown in the contact section and footer. While empty the section says an
# address is being set up instead of rendering a dead mailto link.
NEXT_PUBLIC_CONTACT_EMAIL=
